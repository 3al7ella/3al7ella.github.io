rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['hamdyuwk1@gmail.com'];
    }
    match /orders/{id} {
      allow get: if true;
      allow list, update, delete: if isAdmin();
      allow create: if request.resource.data.status == 'new'
        && request.resource.data.name is string
        && request.resource.data.name.size() < 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() < 20
        && request.resource.data.items is list
        && request.resource.data.items.size() < 60
        && request.resource.data.total is number
        && request.resource.data.createdAt == request.time;
    }
    match /menu/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
